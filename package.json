{
  "name": "raepo",
  "version": "0.1.2",
  "description": "A command-line tool for understanding how long pull requests take to merge in a GitHub repository, broken down by author.",
  "type": "module",
  "bin": {
    "raepo": "dist/raepo.js",
    "ræpo": "dist/raepo.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/thepian/raepo.git"
  },
  "scripts": {
    "prepare": "[ -d .git ] && git config core.hooksPath .githooks || true",
    "build": "bun build src/cli.ts --target=node --outfile=dist/raepo.js && chmod +x dist/raepo.js",
    "raepo": "bun run src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^26.0.1",
    "picocolors": "^1.1.1",
    "typescript": "^6.0.3",
    "valibot": "^1.4.0",
    "vitest": "^4.1.7"
  },
  "license": "MIT",
  "author": "Henrik Vendelbo",
  "keywords": [
    "github",
    "pull-request",
    "pr",
    "metrics",
    "cli"
  ]
}
